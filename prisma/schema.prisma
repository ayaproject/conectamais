// Modelo de dados do Conecta+.
// Esta versão cobre a primeira entrega: contas, papéis, sessões,
// perfil de prestador, aprovação administrativa e auditoria.
// As demais entidades do plano (catálogo, contratações, financeiro...)
// entram nas fases seguintes, cada uma com sua migração.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  PROVIDER
  ADMIN
}

// Permissões administrativas finas (menor privilégio).
// Ter o papel ADMIN sem nenhuma permissão não dá acesso a operação alguma.
enum AdminPermission {
  APPROVE_PROVIDERS
  SUSPEND_PROVIDERS
  VERIFY_DOCUMENTS
  MANAGE_CATALOG // categorias e cidades atendidas
  MODERATE_SERVICES
  READ_AUDIT_LOG
  MANAGE_ADMINS
}

// Tipos de documento de verificação. As exigências por tipo de cadastro ficam em
// src/domain/verification.ts.
enum DocumentType {
  RG
  CNH
  CNPJ_CARD // comprovante de inscrição no CNPJ
  COMPANY_ACT // contrato social, requerimento de empresário ou CCMEI
}

// A quem o documento se refere: a pessoa (prestador ou dono da empresa) ou a empresa.
enum DocumentSubject {
  PERSON
  COMPANY
}

enum DocumentStatus {
  PENDING // aguardando análise
  ACCEPTED
  REJECTED
  SUPERSEDED // substituído por um envio mais novo
}

enum PricingMode {
  FIXED // preço definido
  QUOTE // mediante orçamento
}

enum PriceUnit {
  PER_SERVICE
  PER_HOUR
  PER_SQUARE_METER
}

enum ServiceStatus {
  DRAFT
  PUBLISHED
  PAUSED // pausado pelo prestador
  REMOVED // removido pela moderação
}

enum BadgeDecision {
  GRANTED
  REVOKED
}

enum ProviderStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  SUSPENDED
  DEACTIVATED
}

enum ProviderKind {
  INDIVIDUAL // pessoa física
  COMPANY // pessoa jurídica (MEI ou empresa)
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  roles            UserRole[]
  adminPermissions UserAdminPermission[]
  sessions         Session[]
  providerProfile  ProviderProfile?
  auditLogs        AuditLog[]               @relation("AuditActor")
  statusChanges    ProviderStatusHistory[]  @relation("StatusActor")
  documentReviews  VerificationDocument[]   @relation("DocumentReviewer")
  badgeDecisions   VerificationBadgeEvent[] @relation("BadgeActor")

  @@map("users")
}

model UserRole {
  userId    String
  role      Role
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@map("user_roles")
}

model UserAdminPermission {
  userId     String
  permission AdminPermission
  grantedAt  DateTime        @default(now())
  grantedBy  String? // null quando concedida pelo script de bootstrap
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, permission])
  @@map("user_admin_permissions")
}

// Sessões no banco: o cookie guarda um token aleatório; aqui fica só o hash SHA-256.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model ProviderProfile {
  id                String         @id @default(cuid())
  userId            String         @unique
  kind              ProviderKind   @default(INDIVIDUAL)
  legalName         String         @default("") // nome completo ou razão social (privado)
  displayName       String         @default("") // nome profissional ou fantasia (público)
  description       String         @default("")
  experience        String         @default("")
  city              String         @default("")
  state             String         @default("") // UF
  website           String?
  googleBusinessUrl String?
  status            ProviderStatus @default(DRAFT)
  submittedAt       DateTime?
  reviewedAt        DateTime?
  // Selo de verificação documental. Não é garantia de qualidade do serviço.
  verifiedAt        DateTime?
  verifiedUntil     DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  user          User                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  statusHistory ProviderStatusHistory[]
  documents     VerificationDocument[]
  badgeHistory  VerificationBadgeEvent[]
  services      Service[]

  @@index([status, submittedAt])
  @@map("provider_profiles")
}

// Histórico imutável de cada mudança de status do cadastro.
model ProviderStatusHistory {
  id         String         @id @default(cuid())
  providerId String
  fromStatus ProviderStatus
  toStatus   ProviderStatus
  reason     String?
  actorId    String
  createdAt  DateTime       @default(now())

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Restrict)
  actor    User            @relation("StatusActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([providerId, createdAt])
  @@map("provider_status_history")
}

// Registro de auditoria append-only. Não guarda senhas, tokens nem documentos.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String? // null para ações do sistema (scripts)
  action     String
  entityType String
  entityId   String
  details    Json?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

// Documento enviado para verificação. O arquivo fica em armazenamento privado;
// aqui ficam só metadados. Nunca é exibido publicamente.
model VerificationDocument {
  id           String          @id @default(cuid())
  providerId   String
  type         DocumentType
  subject      DocumentSubject
  storageKey   String          @unique
  originalName String
  mimeType     String
  sizeBytes    Int
  sha256       String
  status       DocumentStatus  @default(PENDING)
  reviewNote   String?
  reviewedById String?
  reviewedAt   DateTime?
  uploadedAt   DateTime        @default(now())

  provider   ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Restrict)
  reviewedBy User?           @relation("DocumentReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([providerId, subject, status])
  @@map("verification_documents")
}

// Histórico do selo: cada concessão ou remoção, com critérios, responsável e validade.
model VerificationBadgeEvent {
  id         String        @id @default(cuid())
  providerId String
  decision   BadgeDecision
  criteria   Json // documentos aceitos considerados na decisão
  validUntil DateTime?
  note       String?
  actorId    String
  createdAt  DateTime      @default(now())

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Restrict)
  actor    User            @relation("BadgeActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([providerId, createdAt])
  @@map("verification_badge_events")
}

// Categorias e subcategorias (subcategoria = categoria com pai). Gerenciadas pelo admin;
// nenhuma lista fixa no código. As iniciais vêm de prisma/seed.ts.
model Category {
  id          String   @id @default(cuid())
  parentId    String?
  name        String
  slug        String   @unique
  description String   @default("")
  searchName  String // nome normalizado (minúsculo, sem acento) para a busca
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  services Service[]

  @@index([parentId, sortOrder])
  @@map("categories")
}

// Cidades atendidas pela plataforma. Lista gerenciada pelo admin.
model City {
  id        String   @id @default(cuid())
  name      String
  state     String // UF
  slug      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  services ServiceCity[]

  @@unique([name, state])
  @@map("cities")
}

model Service {
  id                String        @id @default(cuid())
  providerId        String
  categoryId        String
  title             String
  slug              String        @unique
  description       String
  pricingMode       PricingMode
  priceCents        Int? // obrigatório quando FIXED
  priceUnit         PriceUnit?
  estimatedDuration String        @default("")
  conditions        String        @default("")
  status            ServiceStatus @default(DRAFT)
  searchText        String // título + descrição normalizados para a busca
  publishedAt       DateTime?
  moderationNote    String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Restrict)
  category Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  cities   ServiceCity[]

  @@index([status, categoryId])
  @@index([providerId])
  @@map("services")
}

model ServiceCity {
  serviceId String
  cityId    String

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  city    City    @relation(fields: [cityId], references: [id], onDelete: Restrict)

  @@id([serviceId, cityId])
  @@index([cityId])
  @@map("service_cities")
}
