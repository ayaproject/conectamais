# Copie para .env e ajuste. Nunca faça commit do .env.
# Postgres (local: Docker ou instalação; homologação/produção: Supabase).
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:5432/conecta"

# Armazenamento de documentos de verificação.
# "local" grava em STORAGE_LOCAL_DIR (padrão .storage/private). Não é permitido em produção,
# a menos que ALLOW_LOCAL_STORAGE_IN_PRODUCTION=true (apenas para testes automatizados).
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR=".storage/private"
